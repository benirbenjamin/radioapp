# Database URL for PostgreSQL (Vercel Postgres, Neon, Supabase, AWS RDS, etc.)
# If left empty in local development, the app will automatically run using its built-in local store!
DATABASE_URL=postgres://default:secret@ep-cool-db-12345.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret Key
JWT_SECRET=super_secret_production_ready_radio_jwt_key_2026

# Server Port (default: 5000)
PORT=5000

# Environment Mode
NODE_ENV=development

# ===================================================================
# EMAIL CONFIGURATION (Choose either Nodemailer SMTP or Resend API)
# If left blank, verification codes and notifications are cleanly logged
# to your server console so you can test immediately without setup!
# ===================================================================

# OPTION 1: Resend API (Recommended for modern cloud deployments)
# Get a free key at https://resend.com
RESEND_API_KEY=
RESEND_FROM=Radio Network <onboarding@resend.dev>

# OPTION 2: Standard SMTP (Nodemailer - Gmail, Hostinger, SendGrid, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Radio Network <noreply@radioplatform.io>
SMTP_SECURE=false
